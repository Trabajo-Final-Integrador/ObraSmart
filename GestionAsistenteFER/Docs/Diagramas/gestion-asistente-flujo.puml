@startuml
title Flujo de interacción - Gestión Asistente

actor Usuario
participant "Frontend Angular" as FE
participant "API Gateway
(8085)" as GW
participant "Gestión Asistente
(8099)" as ASIS
participant "Proveedor IA
(OpenAI / Ollama)" as LLM

Usuario -> FE : Escribe mensaje en el chat
"¿Cómo registro un equipo?"
FE -> GW : POST /asistente/chat
{ mensaje, contexto }
GW -> ASIS : POST /api/asistente/chat
{ mensaje, contexto }

ASIS -> ASIS : Construye prompt
(valida datos, agrega contexto)
ASIS -> LLM : Solicita completado IA
(mensaje + contexto)
LLM --> ASIS : Respuesta generada
(texto)

ASIS -> GW : Respuesta adaptada
{ respuesta, modeloUsado }
GW -> FE : Respuesta HTTP 200
{ respuesta, modeloUsado }
FE -> Usuario : Muestra mensaje del asistente

@enduml
